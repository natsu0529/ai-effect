{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-effect",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public"
  },
  "build": {
    "command": "npm run build:web"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-effect",
      "database_id": "6f400236-2ab6-4b8a-a9f2-5b524e800d51",
      "migrations_dir": "migrations"
    }
  ]
}
